{
  "project": "canvasui",
  "version": "0.1.0",
  "environment": {
    "node": "v22.x",
    "os": "Windows_NT win32 x64",
    "next": "16.2.10",
    "playwright": "1.50.0",
    "typescript": "5.x",
    "target_port_e2e": 3099,
    "target_port_dev": 3001
  },
  "webgl_capabilities": {
    "renderer_flags": ["--use-gl=angle", "--use-angle=default", "--enable-gpu-rasterization", "--enable-zero-copy"],
    "supported_contexts": ["webgl2", "webgl"]
  }
}
